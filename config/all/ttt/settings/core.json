{
  "theme": "default-dark",
  "editor": {
    "tabSize": 4,
    "insertSpaces": true,
    "wordWrap": false,
    "lineNumbers": true,
    "cursorStyle": "bar",
    "formatOnSave": false,
    "insertFinalNewline": true,
    "trimTrailingWhitespace": false,
    "focusOnOpen": true,
    "syntaxHighlight": true,
    "autoDedent": true,
    "autoIndent": true,
    "gutterStyle": "compact",
    "borderStyle": "rounded",
    "bracketPairColorization": true,
    "showTrailingNewline": true,
    "menuBar": true,
    "transparentBackground": true
  },
  "welcome": {
    "recentFolders": false
  }
}
